#include <bits/stdc++.h>
using namespace std;

class Node{
    public:
    int data;
    Node* left;
    Node* right;
    Node(int val){
        this->data=val;
        this->left=NULL;
        this->right=NULL;
    }
};

Node* insert(Node* root, int value){
    if(root==NULL)
    return new Node(value);
    
    if(value < root->data){
        root->left= insert(root->left, value);
    }
    else{
        root->right= insert(root->right, value);
    }
    return root;
}

int main() {
	// your code goes here
    Node* root=NULL;
    vector<int>arr={53, -2, 5, 78, 13, 88, 12, 68, 19, 20};
    int n= arr.size();
    for(int i=0; i<n; i++){
        insert(root, arr[i]);
    }
}
