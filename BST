#include <bits/stdc++.h>
using namespace std;

class Node{
    public:
    int data;
    Node* left;
    Node* right;
    Node(int val){
        this->data=val;
        this->left=NULL;
        this->right=NULL;
    }
};

Node* insert(Node* root, int value){
    if(root==NULL)
    return new Node(value);
    
    if(value < root->data){
        root->left= insert(root->left, value);
    }
    else{
        root->right= insert(root->right, value);
    }
    return root;
}

void preorder(Node* root){
    if(root==NULL) return;
    
    cout<<root->data<<" ";
    preorder(root->left);
    preorder(root->right);
}
void inorder(Node* root){
    if(root==NULL) return;
    
    inorder(root->left);
    cout<<root->data<<" ";
    inorder(root->right);
}
void postorder(Node* root){
    if(root==NULL) return;
    
    postorder(root->left);
    postorder(root->right);
    cout<<root->data<<" ";
}
bool search(Node* root, int target) {
    if(root==NULL){
         return false;
    }
    else if(root->data==target){
         return true;
    }
    else if(target < root->data){
        return search(root-> left, target);
    }else {
        return search(root->right, target);
    }
}
